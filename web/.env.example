# MongoDB connection string. For free local dev see README; or use a MongoDB Atlas M0 (free) URI.
MONGODB_URI=mongodb://localhost:27017/solana-bonds

# Solana RPC endpoint (local validator for dev, or a devnet URL).
SOLANA_URL=http://localhost:8899
# Same RPC URL exposed to the browser, used only to build explorer links.
NEXT_PUBLIC_SOLANA_URL=http://localhost:8899

NODE_ENV=development

# 32-byte key (hex = 64 chars, or base64) for AES-256-GCM private-key encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64

# Secret for signing session cookies (JWT). Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-random-secret
